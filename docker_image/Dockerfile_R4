# Use Ubuntu 22.04 base
FROM ubuntu:22.04

# Noninteractive apt
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies for R and package compilation
RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    dirmngr \
    gnupg \
    wget \
    ca-certificates \
    build-essential \
    libcurl4-openssl-dev \
    libssl-dev \
    libxml2-dev \
    libfontconfig1-dev \
    libfreetype6-dev \
    libpng-dev \
    libtiff5-dev \
    libjpeg-dev \
    libcairo2-dev \
    pandoc \
    libharfbuzz-dev \
    libfribidi-dev \
    libicu-dev \
    git \
    && rm -rf /var/lib/apt/lists/*

# Add CRAN repository and key
RUN wget -qO- https://cloud.r-project.org/bin/linux/ubuntu/marutter_pubkey.asc | gpg --dearmor > /usr/share/keyrings/cran.gpg && \
    echo "deb [signed-by=/usr/share/keyrings/cran.gpg] https://cloud.r-project.org/bin/linux/ubuntu jammy-cran40/" > /etc/apt/sources.list.d/cran.list

# Install R
RUN apt-get update && apt-get install -y --no-install-recommends \
    r-base \
    r-base-dev \
    && rm -rf /var/lib/apt/lists/*

# Install base R packages needed for building source dependencies
RUN R -e "install.packages(c('base64enc','jsonlite','lifecycle','cpp11'), repos='https://cloud.r-project.org/')"

# Install source R packages in correct order
RUN R -e "install.packages('https://cran.r-project.org/src/contrib/ragg_1.5.0.tar.gz', repos=NULL, type='source', dependencies=TRUE)"
RUN R -e "install.packages('https://cran.r-project.org/src/contrib/systemfonts_1.3.1.tar.gz', repos=NULL, type='source', dependencies=TRUE)"
RUN R -e "install.packages('https://cran.r-project.org/src/contrib/textshaping_1.0.4.tar.gz', repos=NULL, type='source', dependencies=TRUE)"
RUN R -e "install.packages('https://cran.r-project.org/src/contrib/pkgdown_2.1.3.tar.gz', repos=NULL, type='source', dependencies=TRUE)"

# Install main CRAN packages
RUN R -e "install.packages(c('tidyverse','ggplot2','devtools'), repos='https://cloud.r-project.org/', dependencies=TRUE)"

# Install Bioconductor packages
RUN R -e "install.packages('BiocManager', repos='https://cloud.r-project.org/')" && \
    R -e "BiocManager::install(c('DESeq2','edgeR','limma','GenomicFeatures','GenomicRanges','rtracklayer','tximport'), ask=FALSE, update=FALSE)"

RUN R -e "install.packages(c('R.utils'), dependencies=TRUE)"

# Set working directory
WORKDIR /data

# Default command
CMD ["R"]
